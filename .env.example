# Application Configuration
PROJECT_NAME="API Sentinel"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# API Versioning Prefix
API_V1_PREFIX="/api/v1"

# Request Logging & Client Identification
DEFAULT_CLIENT_ID="anonymous-client"
DEFAULT_LOGS_LIMIT=50
MAX_LOGS_LIMIT=100

# Rule-Based Abuse Detection Thresholds
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_SECONDS=60
BURST_REQUEST_THRESHOLD=30
BURST_WINDOW_SECONDS=10
PROBING_DISTINCT_PATHS_THRESHOLD=5
PROBING_404_THRESHOLD=3
PROBING_WINDOW_SECONDS=60
ALERT_COOLDOWN_SECONDS=60
DEFAULT_ALERTS_LIMIT=50
MAX_ALERTS_LIMIT=100

# Storage Backend ('memory' for local test/dev, 'mongodb' for persistent storage)
STORAGE_BACKEND="memory"

# MongoDB Atlas Configuration (Required only when STORAGE_BACKEND="mongodb")
# Set your real Atlas SRV connection string when using 'mongodb' backend. Leave empty for in-memory mode.
# Example: MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_URI=""
MONGODB_DATABASE="api_sentinel"

# ML Anomaly Detection Configuration (Isolation Forest)
ML_MODEL_PATH="models/isolation_forest.joblib"
ML_METADATA_PATH="models/model_metadata.json"
ML_OBSERVATION_WINDOW_SECONDS=300
ML_CONTAMINATION=0.05
ML_RANDOM_STATE=42
ML_ALERT_COOLDOWN_SECONDS=300
